// Background Worker: ingest queue consumer, npm-discovery cron and the IndexPackageWorkflow class.
//
// The top level is the local development configuration (`wrangler dev`, local state only). Deployments always pass
// `--env staging` or `--env production`. Bindings are not inherited by environments, so every environment repeats
// all of them. Deploy this Worker before the web Worker: the web Worker's INDEX_WORKFLOW binding names this script.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clarkcant-marketplace-jobs-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // CPU budget per invocation (Workers Paid; up to 300000). README rendering (markdown + sanitising up to the size
  // limit) and tarball parsing run here, so the budget is pinned rather than left to the plan default. `limits` is
  // inheritable, but each environment below repeats it so every deployment states it.
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "PUBLIC_SITE_URL": "http://localhost:4321",
    "ENVIRONMENT": "development",
    "ADMIN_EMAILS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clarkcant-marketplace-db-staging",
      "database_id": "8e992426-e304-417f-ad62-631a3bedbdb2",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media-staging" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest-staging" }],
    "consumers": [
      {
        "queue": "clarkcant-marketplace-ingest-staging",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "clarkcant-marketplace-ingest-staging-dlq"
      }
    ]
  },
  "workflows": [
    { "name": "clarkcant-marketplace-index-local", "binding": "INDEX_WORKFLOW", "class_name": "IndexPackageWorkflow" }
  ],
  "triggers": { "crons": ["17 */6 * * *", "*/10 * * * *"] },
  "env": {
    "staging": {
      "name": "clarkcant-marketplace-jobs-staging",
      "limits": { "cpu_ms": 30000 },
      "vars": {
        // Deployed web origin, served on a Workers Custom Domain in the clarkcant.cc zone. ADMIN_EMAILS is a wrangler secret per env.
        "PUBLIC_SITE_URL": "https://staging.marketplace.clarkcant.cc",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clarkcant-marketplace-db-staging",
          "database_id": "8e992426-e304-417f-ad62-631a3bedbdb2",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media-staging" }],
      "queues": {
        "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest-staging" }],
        "consumers": [
          {
            "queue": "clarkcant-marketplace-ingest-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "clarkcant-marketplace-ingest-staging-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "clarkcant-marketplace-index-staging",
          "binding": "INDEX_WORKFLOW",
          "class_name": "IndexPackageWorkflow"
        }
      ],
      "triggers": { "crons": ["17 */6 * * *", "*/10 * * * *"] }
    },
    "production": {
      "name": "clarkcant-marketplace-jobs",
      "limits": { "cpu_ms": 30000 },
      "vars": {
        // Deployed web origin; see the staging note.
        "PUBLIC_SITE_URL": "https://marketplace.clarkcant.cc",
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clarkcant-marketplace-db",
          "database_id": "243263e2-442e-4152-976f-0d0a7845eae7",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media" }],
      "queues": {
        "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest" }],
        "consumers": [
          {
            "queue": "clarkcant-marketplace-ingest",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "clarkcant-marketplace-ingest-dlq"
          }
        ]
      },
      "workflows": [
        { "name": "clarkcant-marketplace-index", "binding": "INDEX_WORKFLOW", "class_name": "IndexPackageWorkflow" }
      ],
      "triggers": { "crons": ["17 */6 * * *", "*/10 * * * *"] }
    }
  }
}

// Web Worker: Astro SSR, the public REST API (/api/v1/*) and /openapi.json.
//
// The top level is the local development configuration used by `astro dev` (local state only). Deploys select an
// environment at build time: `CLOUDFLARE_ENV=staging astro build && wrangler deploy`. The build writes a flattened
// config plus a redirect (.wrangler/deploy/config.json) that wrangler follows whenever `--config` is absent, so a
// later `--env` cannot switch environments. Commands that must honour `--env` (the `db:migrate:*` scripts and the
// deploy workflow's D1 steps) pass `--config wrangler.jsonc` to read this file instead. Bindings are not inherited by environments, so
// every environment repeats all of them. INDEX_WORKFLOW points at the jobs Worker, which must be deployed first.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clarkcant-marketplace-web-local",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_SITE_URL": "http://localhost:4321",
    "ENVIRONMENT": "development",
    "ADMIN_EMAILS": "",
    // Public Cloudflare Web Analytics site token (dashboard > Analytics & Logs > Web Analytics > the site's JS snippet).
    // Not a secret: it ships in every page that loads the beacon. Empty disables analytics. The beacon still loads only
    // after the visitor opts in to the analytics consent category.
    "CF_WEB_ANALYTICS_TOKEN": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clarkcant-marketplace-db-staging",
      "database_id": "8e992426-e304-417f-ad62-631a3bedbdb2",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media-staging" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest-staging" }]
  },
  "workflows": [
    {
      "name": "clarkcant-marketplace-index-local",
      "binding": "INDEX_WORKFLOW",
      "class_name": "IndexPackageWorkflow",
      "script_name": "clarkcant-marketplace-jobs-local"
    }
  ],
  // Per-caller request budgets (per 60 s, per Cloudflare location) enforced by src/middleware/rate-limit.ts. Namespace ids
  // differ per environment so counters never mix. Better Auth adds stricter per-endpoint limits for sign-in in D1.
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "PUBLISH_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "clarkcant-marketplace-web-staging",
      // Workers Custom Domain: deploy creates the DNS record and certificate in the clarkcant.cc zone.
      "routes": [{ "pattern": "staging.marketplace.clarkcant.cc", "custom_domain": true }],
      "vars": {
        // Deployed web origin, served on a Workers Custom Domain in the clarkcant.cc zone. ADMIN_EMAILS is a wrangler secret per env.
        "PUBLIC_SITE_URL": "https://staging.marketplace.clarkcant.cc",
        "ENVIRONMENT": "staging",
        // Empty here: deploy.yml passes the CF_WEB_ANALYTICS_TOKEN GitHub environment variable with `--var`.
        "CF_WEB_ANALYTICS_TOKEN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clarkcant-marketplace-db-staging",
          "database_id": "8e992426-e304-417f-ad62-631a3bedbdb2",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media-staging" }],
      "queues": {
        "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest-staging" }]
      },
      "workflows": [
        {
          "name": "clarkcant-marketplace-index-staging",
          "binding": "INDEX_WORKFLOW",
          "class_name": "IndexPackageWorkflow",
          "script_name": "clarkcant-marketplace-jobs-staging"
        }
      ],
      "observability": { "enabled": true },
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "SEARCH_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLISH_RATE_LIMITER", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "production": {
      "name": "clarkcant-marketplace-web",
      "routes": [{ "pattern": "marketplace.clarkcant.cc", "custom_domain": true }],
      "vars": {
        // Deployed web origin; see the staging note.
        "PUBLIC_SITE_URL": "https://marketplace.clarkcant.cc",
        "ENVIRONMENT": "production",
        // Empty here: deploy.yml passes the CF_WEB_ANALYTICS_TOKEN GitHub environment variable with `--var`.
        "CF_WEB_ANALYTICS_TOKEN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clarkcant-marketplace-db",
          "database_id": "243263e2-442e-4152-976f-0d0a7845eae7",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "clarkcant-marketplace-media" }],
      "queues": {
        "producers": [{ "binding": "INGEST_QUEUE", "queue": "clarkcant-marketplace-ingest" }]
      },
      "workflows": [
        {
          "name": "clarkcant-marketplace-index",
          "binding": "INDEX_WORKFLOW",
          "class_name": "IndexPackageWorkflow",
          "script_name": "clarkcant-marketplace-jobs"
        }
      ],
      "observability": { "enabled": true },
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 300, "period": 60 } },
        { "name": "SEARCH_RATE_LIMITER", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "3003", "simple": { "limit": 60, "period": 60 } },
        { "name": "PUBLISH_RATE_LIMITER", "namespace_id": "3004", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}

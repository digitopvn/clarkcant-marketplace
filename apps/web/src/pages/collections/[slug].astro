---
import { isMarketplaceError, type CollectionDetail } from "@marketplace/contracts";
import { getCollection } from "@marketplace/marketplace";

import PackageGrid from "../../components/package/PackageGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRequestContext } from "../../server/request-context";
import { collectionSeo } from "../../server/seo";

export const prerender = false;

const { deps, vars } = createRequestContext();
const slug = Astro.params.slug ?? "";

let collection: CollectionDetail | null = null;
try {
  collection = await getCollection(deps, slug);
} catch (error) {
  if (!isMarketplaceError(error) || (error.code !== "not_found" && error.code !== "validation_failed")) throw error;
  Astro.response.status = 404;
}
---

{
  collection ? (
    <BaseLayout
      title={collection.title}
      description={collection.description || `${collection.title}: a ClarkCant collection`}
      seo={collectionSeo(vars.PUBLIC_SITE_URL, collection)}
    >
      <section class="container-page py-10">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <a href="/collections" class="hover:text-ink">Collections</a>
        </nav>
        <h1 class="mt-2 font-display text-4xl sm:text-5xl">{collection.title}</h1>
        {collection.description && <p class="mt-3 max-w-2xl text-lg text-muted">{collection.description}</p>}
      </section>
      <section class="container-page pb-12">
        <PackageGrid items={collection.packages} emptyMessage="This collection has no listed packages right now." />
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="Collection not found">
      <section class="container-page py-16">
        <h1 class="font-display text-4xl">Collection not found</h1>
        <p class="mt-3 text-muted">There is no published collection called “{slug}”.</p>
        <a href="/collections" class="mt-6 inline-flex rounded-full border border-line px-5 py-2.5 text-sm hover:border-accent">
          All collections
        </a>
      </section>
    </BaseLayout>
  )
}

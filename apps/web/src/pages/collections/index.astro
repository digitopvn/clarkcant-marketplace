---
import { listCollections } from "@marketplace/marketplace";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRequestContext } from "../../server/request-context";

export const prerender = false;

const { deps } = createRequestContext();
const collections = await listCollections(deps);
---

<BaseLayout title="Collections" description="Curated collections of ClarkCant packages." seo={{ markdown: false }}>
  <section class="container-page py-10">
    <h1 class="font-display text-4xl sm:text-5xl">Collections</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">Hand-picked sets of packages, chosen by the marketplace curators.</p>
  </section>
  <section class="container-page pb-12">
    {
      collections.length === 0 ? (
        <div class="rounded-card border border-dashed border-line bg-raised p-10 text-center">
          <h2 class="font-display text-3xl">No collections yet</h2>
          <p class="mt-2 text-muted">Curators have not published a collection yet.</p>
        </div>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {collections.map((collection) => (
            <li>
              <a
                href={`/collections/${collection.slug}`}
                class="flex h-full flex-col gap-2 rounded-card border border-line bg-card p-5 shadow-card hover:border-accent"
              >
                <h2 class="font-display text-2xl">{collection.title}</h2>
                {collection.description && <p class="text-sm text-muted">{collection.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

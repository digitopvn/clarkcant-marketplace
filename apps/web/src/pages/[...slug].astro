---
import { isMarketplaceError } from "@marketplace/contracts";
import { HOME_PAGE_SLUG, getPublishedPage, pagePath, renderPageDocument, type PublishedPage } from "@marketplace/marketplace";

import { markdownPathFor, techArticleJsonLd } from "@marketplace/seo";

import RenderedPage from "../components/page-engine/RenderedPage.astro";
import BaseLayout, { type SeoProps } from "../layouts/BaseLayout.astro";
import { createRequestContext } from "../server/request-context";

export const prerender = false;

/*
 * Published builder pages (about, legal, docs, campaign pages). Every more specific route wins over this catch-all,
 * and the page service refuses slugs reserved for them, so a page can never shadow a product route.
 */

const slug = Astro.params.slug ?? "";
if (slug === HOME_PAGE_SLUG) return Astro.redirect("/", 301);

const { deps, vars } = createRequestContext();
let page: PublishedPage | null = null;
try {
  page = await getPublishedPage(deps, slug);
} catch (error) {
  // Unknown and malformed slugs are both "no such page" to a visitor.
  if (!isMarketplaceError(error) || (error.code !== "not_found" && error.code !== "validation_failed")) throw error;
}

const rendered = page
  ? await renderPageDocument(deps, page.document, { mode: "public", siteUrl: vars.PUBLIC_SITE_URL, path: pagePath(page.page.slug) })
  : null;

if (!page || !rendered) {
  Astro.response.status = 404;
} else {
  const canonical = `${vars.PUBLIC_SITE_URL}${pagePath(page.page.slug)}`;
  const markdown = `${vars.PUBLIC_SITE_URL}${markdownPathFor(pagePath(page.page.slug))}`;
  Astro.response.headers.set("Link", `<${canonical}>; rel="canonical", <${markdown}>; rel="alternate"; type="text/markdown"`);
  Astro.response.headers.set("ETag", `"${page.revisionId}"`);
  if (page.document.meta.noindex) Astro.response.headers.set("X-Robots-Tag", "noindex");
}

const isArticle = page?.page.kind === "legal" || page?.page.kind === "docs";
const seo: SeoProps | undefined =
  page && rendered
    ? {
        path: pagePath(page.page.slug),
        type: isArticle ? "article" : "website",
        image: rendered.socialImage,
        noindex: page.document.meta.noindex,
        locale: page.document.meta.locale,
        jsonLd: isArticle
          ? [
              techArticleJsonLd(vars.PUBLIC_SITE_URL, {
                title: page.document.meta.title,
                description: page.document.meta.description,
                path: pagePath(page.page.slug),
                dateModified: page.publishedAt,
                locale: page.document.meta.locale,
              }),
            ]
          : [],
      }
    : undefined;
---

{
  page && rendered ? (
    <BaseLayout title={page.document.meta.title} description={page.document.meta.description || undefined} seo={seo}>
      <RenderedPage html={rendered.html} structuredData={rendered.structuredData} />
    </BaseLayout>
  ) : (
    <BaseLayout title="Page not found">
      <section class="container-page py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-faint">404</p>
        <h1 class="mt-3 font-display text-5xl">This page does not exist</h1>
        <p class="mt-4 max-w-xl text-muted">
          It may have moved, or it has not been published yet. <a class="text-accent underline" href="/packages">Browse packages</a>
          or go to the <a class="text-accent underline" href="/">home page</a>.
        </p>
      </section>
    </BaseLayout>
  )
}

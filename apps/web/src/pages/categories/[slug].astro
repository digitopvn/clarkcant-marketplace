---
import { isMarketplaceError, type Category, type Page, type PackageSummary } from "@marketplace/contracts";
import { getCategory, listPackages } from "@marketplace/marketplace";

import PackageGrid from "../../components/package/PackageGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRequestContext } from "../../server/request-context";

export const prerender = false;

const { deps } = createRequestContext();
const slug = Astro.params.slug ?? "";
const cursor = Astro.url.searchParams.get("cursor") || undefined;

let category: Category | null = null;
let page: Page<PackageSummary> | null = null;
try {
  category = await getCategory(deps, slug);
  page = await listPackages(deps, { category: category.slug, cursor });
} catch (error) {
  if (!isMarketplaceError(error) || (error.code !== "not_found" && error.code !== "validation_failed")) throw error;
  Astro.response.status = 404;
}
---

{
  category && page ? (
    <BaseLayout title={category.name} description={category.description || `${category.name} packages for ClarkCant`}>
      <section class="container-page py-10">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <a href="/packages" class="hover:text-ink">Packages</a> / Categories
        </nav>
        <h1 class="mt-2 font-display text-4xl sm:text-5xl">{category.name}</h1>
        {category.description && <p class="mt-3 max-w-2xl text-lg text-muted">{category.description}</p>}
      </section>
      <section class="container-page pb-12">
        <PackageGrid
          items={page.items}
          nextHref={page.nextCursor ? `/categories/${category.slug}?cursor=${encodeURIComponent(page.nextCursor)}` : null}
          emptyMessage="No listed packages in this category yet."
        />
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="Category not found">
      <section class="container-page py-16">
        <h1 class="font-display text-4xl">Category not found</h1>
        <p class="mt-3 text-muted">There is no category called “{slug}”.</p>
        <a href="/packages" class="mt-6 inline-flex rounded-full border border-line px-5 py-2.5 text-sm hover:border-accent">
          Browse packages
        </a>
      </section>
    </BaseLayout>
  )
}

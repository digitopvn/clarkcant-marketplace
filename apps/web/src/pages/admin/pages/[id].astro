---
import { isMarketplaceError } from "@marketplace/contracts";
import { describeBlocks, getPage, listLayouts, listPageRevisions, type PageState } from "@marketplace/marketplace";
import { BLOCK_STYLES } from "@marketplace/page-engine";

import PageBuilder from "../../../components/admin/PageBuilder";
import WebmcpBuilderTools from "../../../components/webmcp/WebmcpBuilderTools.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import tokensCss from "../../../styles/tokens.css?raw";
import { createRequestContext } from "../../../server/request-context";

export const prerender = false;

// The middleware admits only admins to /admin; the services still check `pages:write` themselves.
const { deps, vars } = createRequestContext();
const actor = Astro.locals.actor;
const pageId = Astro.params.id ?? "";

let state: PageState | null = null;
try {
  state = await getPage(deps, actor, pageId);
} catch (error) {
  if (!isMarketplaceError(error) || (error.code !== "not_found" && error.code !== "validation_failed")) throw error;
}
const revisions = state ? await listPageRevisions(deps, actor, state.page.id) : [];
if (!state) Astro.response.status = 404;
Astro.response.headers.set("X-Robots-Tag", "noindex");

// Layout definitions hold readonly arrays; the island receives plain JSON copies.
const layouts = listLayouts().map((layout) => ({ ...layout, regions: layout.regions.map((region) => ({ ...region, allowedBlocks: [...region.allowedBlocks] })) }));

// The canvas iframe (srcdoc) inherits this page's CSP. Its inline script and style are fixed at build time and
// allowed by hash in astro.config.ts, which hashes this same CANVAS_SCRIPT and `canvasStyle(tokens + BLOCK_STYLES)`.
const canvasCss = `${tokensCss}\n${BLOCK_STYLES}`;
---

<BaseLayout title={state ? `Edit ${state.draft.document.meta.title} · Admin` : "Page not found · Admin"}>
  {
    state ? (
      <PageBuilder
        client:load
        initialState={state}
        initialRevisions={revisions}
        blocks={describeBlocks()}
        layouts={layouts}
        siteUrl={vars.PUBLIC_SITE_URL}
        canvasCss={canvasCss}
      />
    ) : (
      <section class="container-page py-16">
        <h1 class="font-display text-4xl">Page not found</h1>
        <p class="mt-3 text-muted">
          <a class="text-accent underline" href="/admin/pages">Back to all pages</a>
        </p>
      </section>
    )
  }
  {state && <WebmcpBuilderTools />}
</BaseLayout>

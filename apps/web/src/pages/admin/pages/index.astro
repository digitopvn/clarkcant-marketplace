---
import { DEFAULT_PAGES, listPages, pagePath } from "@marketplace/marketplace";

import CreatePageForm from "../../../components/admin/CreatePageForm";
import DefaultPagesButton from "../../../components/admin/DefaultPagesButton";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { createRequestContext } from "../../../server/request-context";

export const prerender = false;

// The middleware admits only admins to /admin; the service still checks the scope itself.
const { deps } = createRequestContext();
const pages = await listPages(deps, Astro.locals.actor);
Astro.response.headers.set("X-Robots-Tag", "noindex");
const missingDefaults = DEFAULT_PAGES.map((page) => page.slug).filter((slug) => !pages.some((page) => page.slug === slug));

const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" });
---

<BaseLayout title="Pages · Admin">
  <section class="container-page py-10">
    <p class="font-mono text-xs uppercase tracking-widest text-faint">Admin</p>
    <h1 class="mt-2 font-display text-4xl">Pages</h1>
    <p class="mt-2 max-w-2xl text-muted">
      Pages are block documents with immutable revisions. Edit a draft in the builder, preview it, then publish; any
      previously published revision can be rolled back to.
    </p>

    {missingDefaults.length > 0 && <DefaultPagesButton client:load missing={missingDefaults} />}

    <div class="mt-8 rounded-card border border-line bg-card p-5">
      <h2 class="mb-3 font-display text-2xl">New page</h2>
      <CreatePageForm client:load />
    </div>

    {
      pages.length === 0 ? (
        <p class="mt-8 rounded-card border border-dashed border-line p-8 text-center text-muted">No pages yet.</p>
      ) : (
        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[36rem] text-left text-sm">
            <caption class="sr-only">All pages</caption>
            <thead class="border-b border-line text-muted">
              <tr>
                <th scope="col" class="py-2 pr-4 font-medium">Title</th>
                <th scope="col" class="py-2 pr-4 font-medium">Path</th>
                <th scope="col" class="py-2 pr-4 font-medium">Kind</th>
                <th scope="col" class="py-2 pr-4 font-medium">Status</th>
                <th scope="col" class="py-2 font-medium">Updated (UTC)</th>
              </tr>
            </thead>
            <tbody>
              {pages.map((page) => {
                const status = !page.publishedRevisionId
                  ? "Draft only"
                  : page.publishedRevisionId === page.currentDraftRevisionId
                    ? "Published"
                    : "Published, unpublished changes";
                return (
                  <tr class="border-b border-line">
                    <td class="py-2 pr-4">
                      <a class="text-accent underline-offset-4 hover:underline" href={`/admin/pages/${encodeURIComponent(page.id)}`}>
                        {page.title}
                      </a>
                    </td>
                    <td class="py-2 pr-4 font-mono">
                      {page.publishedRevisionId ? <a href={pagePath(page.slug)}>{pagePath(page.slug)}</a> : pagePath(page.slug)}
                    </td>
                    <td class="py-2 pr-4">{page.kind}</td>
                    <td class="py-2 pr-4">{status}</td>
                    <td class="py-2">{dateFormat.format(new Date(page.updatedAt))}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</BaseLayout>

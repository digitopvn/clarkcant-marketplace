---
const year = new Date().getFullYear();

const legal = [
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
  { href: "/cookies", label: "Cookies" },
  { href: "/refunds", label: "Refunds" },
  { href: "/gdpr", label: "GDPR" },
  { href: "/security", label: "Security" },
  { href: "/subprocessors", label: "Subprocessors" },
];
const site = [
  { href: "/about", label: "About" },
  { href: "/collections", label: "Collections" },
  { href: "/openapi.json", label: "API" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/sitemap.xml", label: "Sitemap" },
];
---

<footer class="mt-16 border-t border-line">
  <div class="container-page grid gap-6 py-8 text-sm text-muted">
    <p class="max-w-3xl">
      The marketplace discovers and curates. npm distributes. ClarkCant installs and runs. A listing here never grants a
      package any permission.
    </p>
    <nav aria-label="Footer" class="flex flex-col gap-3 sm:flex-row sm:gap-10">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {site.map((link) => <li><a class="hover:text-ink" href={link.href}>{link.label}</a></li>)}
      </ul>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {legal.map((link) => <li><a class="hover:text-ink" href={link.href}>{link.label}</a></li>)}
        <li>
          <button type="button" class="cursor-pointer underline-offset-2 hover:text-ink hover:underline" data-consent-open>
            Cookie settings
          </button>
        </li>
      </ul>
    </nav>
    <p>© {year} ClarkCant</p>
  </div>
</footer>

---
import OrbMark from "./OrbMark.astro";

const year = new Date().getFullYear();

const legal = [
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
  { href: "/cookies", label: "Cookies" },
  { href: "/refunds", label: "Refunds" },
  { href: "/gdpr", label: "GDPR" },
  { href: "/security", label: "Security" },
  { href: "/subprocessors", label: "Subprocessors" },
];
const site = [
  { href: "/about", label: "About" },
  { href: "/packages", label: "Packages" },
  { href: "/collections", label: "Collections" },
  { href: "/docs/api", label: "API" },
  { href: "/openapi.json", label: "OpenAPI" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/sitemap.xml", label: "Sitemap" },
];
---

<footer class="mt-16 border-t border-line">
  <div class="container-page grid gap-6 py-8 text-sm text-muted">
    <p class="max-w-3xl">
      The marketplace discovers and curates. npm distributes. ClarkCant installs and runs. A listing here never grants a
      package any permission.
    </p>
    <nav aria-label="Footer" class="flex flex-col gap-3 sm:flex-row sm:gap-10">
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {site.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}
      </ul>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {legal.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}
        <li>
          <button type="button" class="footer-link" data-consent-open>Cookie settings</button>
        </li>
      </ul>
    </nav>
    <p class="flex items-center gap-2">
      <OrbMark id="orb-footer" class="h-5 w-5" />
      <span>© {year} ClarkCant</span>
    </p>
  </div>
</footer>

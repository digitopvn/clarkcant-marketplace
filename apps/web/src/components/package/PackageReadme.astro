---
interface Props {
  /**
   * README HTML sanitized by `@marketplace/markdown` at index time, with headings already shifted below this
   * section's h2 on the parsed tree. It is rendered exactly as stored: never rewrite it as a string here, because
   * text inside attribute values would be re-read as markup. Never pass unsanitized HTML here.
   */
  html: string | null;
}

const { html } = Astro.props;
---

<section aria-labelledby="readme-heading" class="min-w-0">
  <h2 id="readme-heading" class="sr-only">README</h2>
  {
    html ? (
      <div class="readme" set:html={html} />
    ) : (
      <p class="rounded-card border border-dashed border-line bg-raised p-6 text-muted">This version ships no README.</p>
    )
  }
</section>

<style>
  .readme {
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .readme :global([data-heading-level]) {
    font-weight: 600;
    line-height: 1.3;
    margin: 1.4em 0 0.4em;
  }
  .readme :global([data-heading-level="1"]),
  .readme :global([data-heading-level="2"]),
  .readme :global([data-heading-level="3"]) {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.15;
    margin: 1.6em 0 0.5em;
  }
  .readme :global([data-heading-level="1"]) {
    font-size: var(--step-3);
  }
  .readme :global([data-heading-level="2"]) {
    font-size: var(--step-2);
  }
  .readme :global([data-heading-level="3"]) {
    font-size: var(--step-1);
  }
  .readme > :global(:first-child) {
    margin-top: 0;
  }
  .readme :global(p),
  .readme :global(ul),
  .readme :global(ol),
  .readme :global(pre),
  .readme :global(table),
  .readme :global(blockquote) {
    margin: 0 0 1em;
  }
  .readme :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }
  .readme :global(ol) {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .readme :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .readme :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--code-bg);
    border-radius: 6px;
    padding: 0.1em 0.35em;
  }
  .readme :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    padding: 1em;
  }
  .readme :global(pre code) {
    background: none;
    padding: 0;
  }
  .readme :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
  .readme :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .readme :global(th),
  .readme :global(td) {
    border: 1px solid var(--line);
    padding: 0.4em 0.7em;
    text-align: left;
  }
  .readme :global(blockquote) {
    border-left: 3px solid var(--line-strong);
    color: var(--text-muted);
    padding-left: 1em;
  }
</style>

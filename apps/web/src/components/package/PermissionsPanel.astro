---
import type { PackageVersionDetail } from "@marketplace/contracts";

import {
  RISK_LABELS,
  describePermission,
  describeService,
  isolationLane,
  standalonePermissions,
  type RiskLevel,
} from "./package-labels";

interface Props {
  version: PackageVersionDetail;
}

const { version } = Astro.props;
const lanes = version.facets.map((facet) => ({ facet, lane: isolationLane(facet.isolation) }));
const services = version.services.map(describeService);
const permissions = standalonePermissions(version).map(describePermission);
const riskClass: Record<RiskLevel, string> = {
  low: "border-line text-success",
  moderate: "border-line text-warning",
  high: "border-warning text-warning",
};
---

<section aria-labelledby="permissions-heading" class="rounded-card border border-line bg-card p-5 shadow-card">
  <h2 id="permissions-heading" class="font-display text-2xl">What it asks for</h2>
  <p class="mt-1 text-sm text-muted">
    Declared in <code class="font-mono">clarkcant.json</code>. These are requests, not grants: ClarkCant asks for your
    consent at install time, and a marketplace listing is not a security review.
  </p>

  <h3 class="mt-5 text-sm font-medium">Isolation lanes</h3>
  <ul class="mt-2 grid gap-2">
    {
      lanes.map(({ facet, lane }) => (
        <li class="rounded-lg border border-line bg-raised p-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-sm font-medium">
              {lane.label} <span class="font-mono text-xs text-faint">· {facet.kind}</span>
            </span>
            <span class={`rounded-full border px-2 py-0.5 text-xs ${riskClass[lane.risk]}`}>{RISK_LABELS[lane.risk]}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{lane.summary}</p>
        </li>
      ))
    }
  </ul>

  {
    services.map((service) => (
      <>
        <h3 class="mt-5 text-sm font-medium">
          Service <span class="font-mono text-xs text-faint break-all">{service.title}</span>
        </h3>
        <ul class="mt-2 grid gap-2">
          {service.provides.map((capability) => (
            <li class="rounded-lg border border-line bg-raised p-3">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <span class="min-w-0">
                  <span class="block text-sm font-medium">{capability.title}</span>
                  <span class="block font-mono text-xs text-muted break-all">{capability.detail}</span>
                </span>
                <span class={`rounded-full border px-2 py-0.5 text-xs ${riskClass[capability.risk]}`}>
                  {RISK_LABELS[capability.risk]}
                </span>
              </div>
              {capability.notes.length > 0 && <p class="mt-1 text-sm text-muted">{capability.notes.join(" ")}</p>}
            </li>
          ))}
        </ul>
        {service.reaches.length > 0 && (
          <>
            <h4 class="mt-3 text-xs font-medium text-muted">Reaches, through ClarkCant</h4>
            <ul class="mt-1 grid gap-1 text-sm">
              {service.reaches.map((reach) => (
                <li>
                  <span class="font-mono text-xs break-all">{reach.origin}</span>: {reach.purpose}
                  {reach.credential && <span class="block text-xs text-muted">{reach.credential}</span>}
                </li>
              ))}
            </ul>
          </>
        )}
        {service.secrets.length > 0 && (
          <>
            <h4 class="mt-3 text-xs font-medium text-muted">Secrets you provide</h4>
            <ul class="mt-1 grid gap-1 text-sm">
              {service.secrets.map((secret) => (
                <li>
                  <span class="font-mono text-xs">{secret.name}</span>: {secret.purpose}
                </li>
              ))}
            </ul>
          </>
        )}
        {service.connection && (
          <>
            <h4 class="mt-3 text-xs font-medium text-muted">Account connection: {service.connection.title}</h4>
            <p class="mt-1 text-sm text-muted">{service.connection.signIn}</p>
            <ul class="mt-1 grid gap-1 text-sm">
              {service.connection.scopes.map((scope) => (
                <li>
                  <span class="font-mono text-xs">{scope.scope}</span>: {scope.purpose}
                </li>
              ))}
            </ul>
            <p class="mt-1 text-xs text-muted break-all">Account API: {service.connection.endpoints.join(", ")}</p>
          </>
        )}
      </>
    ))
  }

  <h3 class="mt-5 text-sm font-medium">{services.length > 0 ? "Other permissions" : "Permissions"}</h3>
  {
    permissions.length === 0 ? (
      <p class="mt-2 text-sm text-muted">
        {services.length > 0 ? "Nothing beyond what its services declare above." : "No capabilities, network origins, file paths, secrets, accounts, microphone, camera or lifecycle scripts requested."}
      </p>
    ) : (
      <ul class="mt-2 grid gap-2">
        {permissions.map((permission) => (
          <li class="flex flex-wrap items-start justify-between gap-2 rounded-lg border border-line bg-raised p-3">
            <span class="min-w-0">
              <span class="block text-sm font-medium">{permission.title}</span>
              <span class="block font-mono text-xs text-muted break-all">{permission.detail}</span>
            </span>
            <span class={`rounded-full border px-2 py-0.5 text-xs ${riskClass[permission.risk]}`}>
              {RISK_LABELS[permission.risk]}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</section>

# Names only. Copy to `.env` for local tooling; never commit real values.

# Wrangler authentication for remote commands (deploys, remote migrations). CI reads these from GitHub secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Selects the wrangler environment baked into `astro build` (`staging` or `production`). Empty = local config.
CLOUDFLARE_ENV=

# Points the Playwright suite at a deployed site instead of starting the local dev server.
BASE_URL=
